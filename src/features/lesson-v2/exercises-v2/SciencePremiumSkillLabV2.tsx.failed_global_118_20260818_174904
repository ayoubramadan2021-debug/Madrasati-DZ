// SCIENCE_PREMIUM_LESSON88_V4
import {
  useEffect,
  useState,
  type CSSProperties,
  type PointerEvent as ReactPointerEvent,
} from "react";

type AssetItem = {
  label:string;
  icon:string;
};

type BinItem = AssetItem;

export type SciencePremiumSkillActivityV2 =
  | {
      mode:"choice";
      options:AssetItem[];
      answer:number;
      visual?:AssetItem;
    }
  | {
      mode:"dragBin";
      item:AssetItem;
      bins:BinItem[];
      answer:number;
    }
  | {
      mode:"multiPick";
      items:AssetItem[];
      answers:number[];
    }
  | {
      mode:"transfer";
      liquid:AssetItem;
      containers:string[];
      properties:string[];
      answer:number;
    }
  | {
      mode:"orderTap";
      steps:string[];
      displayOrder:number[];
    }
  | {
      mode:"safeUnsafe";
      scenario:AssetItem;
      safe:boolean;
    }
  | {
      mode:"floatSink";
      item:AssetItem;
      result:"float"|"sink";
    }
  | {
      mode:"dissolve";
      item:AssetItem;
      dissolves:boolean;
    }
  | {
      mode:"eraseTest";
      tool:AssetItem;
      erasable:boolean;
    }
  | {
      mode:"batchSort";
      bins:BinItem[];
      items:Array<AssetItem & {bin:number}>;
    };

type Props = {
  activity:SciencePremiumSkillActivityV2;
  locked:boolean;
  showResult:boolean;
  onResult:(correct:boolean)=>void;
  questionId?:string;
};

const navy="#173A63";
const gold="#F0B72A";
const paleGold="#FFF8DF";
const blue="#4C9DD7";
const green="#51A973";
const ink="#284357";
const border="#D8E6EF";
const panel="#F7FBFE";
const cream="#FFFCF1";
const sky="#EEF7FF";
const mint="#ECF9F1";
const rose="#FFF1F3";

const Scene88Path=(questionId?:string)=>{



  if(questionId?.startsWith("l107_ex2_")) {
    return "/lessons/v2/science-88-116/scenes/scene-l107-safe-storage-v01.webp";
  }

  if(questionId?.startsWith("l107_ex3_")) {
    return "/lessons/v2/science-88-116/scenes/scene-l107-safety-adult-v01.webp";
  }


  if(questionId?.startsWith("l104_ex2_")) {
    return "/lessons/v2/science-88-116/scenes/scene-l104-cleaning-tools-v01.webp";
  }

  if(questionId?.startsWith("l104_ex3_")) {
    return "/lessons/v2/science-88-116/scenes/scene-l104-handwashing-v01.webp";
  }


  if(!questionId?.startsWith("l88_")) return null;

  if(questionId.startsWith("l88_ex1_")) {
    return "/lessons/v2/science-88-116/scenes/scene-l88-material-table-v01.webp";
  }

  if(questionId.startsWith("l88_ex3_")) {
    return "/lessons/v2/science-88-116/scenes/scene-l88-liquid-transfer-v01.webp";
  }

  return null;
};

