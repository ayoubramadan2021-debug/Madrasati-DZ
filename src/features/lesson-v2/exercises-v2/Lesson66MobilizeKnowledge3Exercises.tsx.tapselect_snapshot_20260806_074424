function Activity({
  item,
}: {
  item: Lesson66Item;
}) {
  switch (item.stimulus.kind) {
    case "farm":
      return <FarmBoard item={item} />;

    case "operation":
      return <OperationBoard item={item} />;

    case "table":
      return <TableBoard item={item} />;

    default:
      return <BehaviorBoard item={item} />;
  }
}

function RoundRenderer({
  context,
}: {
  context: any;
}) {
  const item =
    context.item as Lesson66Item;

  const [selectedIndex, setSelectedIndex] =
    useState<number | null>(null);

  useEffect(() => {
    setSelectedIndex(null);
  }, [item.id]);

  const choose = (
    optionIndex: number,
  ) => {
    if (context.locked) return;

    setSelectedIndex(optionIndex);

    if (
      optionIndex ===
      item.correct_index
    ) {
      context.completeRound();
      return;
    }

    context.showWrong(() => {
      setSelectedIndex(null);
    });
  };

  return (
    <div
      dir="rtl"
      style={styles.round}
    >
      <Activity item={item} />

      <div style={styles.optionsGrid}>
        {item.options.map(
          (option, optionIndex) => {
            const selected =
              selectedIndex ===
              optionIndex;

            const correct =
              optionIndex ===
              item.correct_index;

            const correctState =
              selected &&
              correct &&
              context.feedbackState ===
                "correct";

            const wrongState =
              selected &&
              !correct &&
              context.feedbackState ===
                "wrong";

            return (
              <button
                key={`${item.id}-${optionIndex}`}
                type="button"
                disabled={context.locked}
                onClick={() =>
                  choose(optionIndex)
                }
                style={{
                  ...styles.option,
                  borderColor: correctState
                    ? "#20A66A"
                    : wrongState
                      ? "#D64545"
                      : "#E0A225",
                  background: correctState
                    ? "#E9FFF3"
                    : wrongState
                      ? "#FFF0F0"
                      : "#FFFFFF",
                  transform: selected
                    ? "translateY(-2px)"
                    : "none",
                }}
              >
                {option.icon && (
                  <span
                    style={styles.optionIcon}
                    aria-hidden="true"
                  >
                    {option.icon}
                  </span>
                )}

                <strong
                  dir={
                    /^[0-9]+$/.test(
                      option.label,
                    )
                      ? "ltr"
                      : "rtl"
                  }
                  style={
                    /^[0-9]+$/.test(
                      option.label,
                    )
                      ? styles.numericOption
                      : styles.textOption
                  }
                >
                  {option.label}
                </strong>
              </button>
            );
          },
        )}
      </div>
    </div>
  );
}

const TapSelectImagesAny =
  TapSelectImagesV2 as any;

const LessonCompleteAny =
  LessonCompleteV2 as any;

export default function
Lesson66MobilizeKnowledge3Exercises() {
  const navigate = useNavigate();

  const [complete, setComplete] =
    useState(false);

  if (complete) {
    return (
      <LessonCompleteAny
        lessonKey="lesson66"
        title="أَحْسَنْتَ يَا بَطَلُ!"
        subtitle="أَتْقَنْتَ تَمَارِينَ أُجَنِّدُ مَعَارِفِي (3)."
        nextPath="/lesson-v2/67"
        nextLabel="الدَّرْسُ التَّالِي"
        onNext={() =>
          navigate("/lesson-v2/67")
        }
        onContinue={() =>
          navigate("/lesson-v2/67")
        }
        onRetry={() =>
          setComplete(false)
        }
        onRestart={() =>
          setComplete(false)
        }
      />
    );
  }

  return (
    <TapSelectImagesAny
      items={ITEMS}
      audio_base={AUDIO_BASE}
      background_image={
        BACKGROUND_IMAGE
      }
      progress_emoji="⭐"
      mission_prefix="مَهَمَّة"
      render_custom={(
        context: any,
      ) => (
        <RoundRenderer
          key={
            context.item
              .question_audio_key
          }
          context={context}
        />
      )}
      onComplete={() =>
        setComplete(true)
      }
    />
  );
}

